OPENROUTER_API_KEY=

# One model per agent — comma-separated OpenRouter model IDs
# See https://openrouter.ai/models
THINKER_MODELS=google/gemini-3.5-flash,anthropic/claude-haiku-4.5,meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small-3.2-24b-instruct,deepseek/deepseek-v3.2,openai/gpt-4o-mini

THINKER_AGENT_COUNT=6
THINKER_TURN_DELAY_MS=15000
THINKER_CONTEXT_MESSAGES=1
THINKER_MECHANICAL_PROMPT=true
THINKER_COMPLETION_TOKENS=35
THINKER_MAX_REPLY_CHARS=140
THINKER_MAX_CONTEXT_LINE_CHARS=120
THINKER_MAX_RETRIES=4
THINKER_MIN_REPLY_CHARS=10
THINKER_PORT=3847

# Observer — watches chat, never joins, bookmarks important moments
THINKER_CURATOR_MODEL=openai/gpt-4o-mini
THINKER_CURATOR_ENABLED=true
THINKER_CURATOR_CONTEXT=12
THINKER_CURATOR_MAX_TOKENS=512
